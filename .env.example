# MeetingHub - Environment Configuration
# Copy file ini ke .env dan sesuaikan dengan lingkungan Anda

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001
HOST=localhost

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meetinghub
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_refresh_token_secret_key
JWT_REFRESH_EXPIRATION=7d

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM_NAME=MeetingHub
SMTP_FROM_EMAIL=noreply@meetinghub.com

# Email Notifications
EMAIL_NOTIFICATION_ENABLED=true
EMAIL_REMINDER_BEFORE_HOURS=1
EMAIL_ADMIN_ON_NEW_MEETING=true

# ============================================
# FRONTEND CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:3000
FRONTEND_PROD_URL=https://meetinghub.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://meetinghub.com

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,gif
TEMP_DIR=./temp

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_LOCKOUT_MINUTES=15

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_ENABLED=true
CACHE_PROVIDER=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=3600

# ============================================
# NOTIFICATION CONFIGURATION
# ============================================
NOTIFICATION_ENABLED=true
NOTIFICATION_PROVIDER=email
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# MEETING CONFIGURATION
# ============================================
MEETING_REMINDER_ADVANCE_HOURS=24,1
MEETING_MIN_DURATION_MINUTES=15
MEETING_MAX_DURATION_MINUTES=480
AUTO_END_MEETING_MINUTES=0
TIMEZONE=Asia/Jakarta

# ============================================
# REPORT CONFIGURATION
# ============================================
REPORT_STORAGE=local
REPORT_DIR=./reports
PDF_INCLUDE_PARTICIPANTS=true
PDF_INCLUDE_NOTES=true
EXCEL_MAX_ROWS=10000

# ============================================
# SECURITY CONFIGURATION
# ============================================
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENABLE_CORS=true
ENABLE_HELMET=true
ENABLE_COMPRESSION=true
BCRYPT_ROUNDS=10

# ============================================
# STRIPE CONFIGURATION (Optional - for Premium)
# ============================================
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================
# AWS CONFIGURATION (Optional - for S3 uploads)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=meetinghub-uploads
AWS_S3_ENABLE=false

# ============================================
# MONITORING & ANALYTICS
# ============================================
ANALYTICS_ENABLED=true
SENTRY_DSN=
DATADOG_API_KEY=
NEWRELIC_LICENSE_KEY=

# ============================================
# API RATE LIMITING
# ============================================
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW=15
API_RATE_LIMIT_MAX=100

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_SUMMARY=false
FEATURE_VIDEO_INTEGRATION=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_TEAMS_INTEGRATION=false
FEATURE_SLACK_INTEGRATION=false

# ============================================
# DEBUG & DEVELOPMENT
# ============================================
DEBUG_MODE=false
ENABLE_SWAGGER=true
ENABLE_MOCK_DATA=false
PRETTY_LOGS=true

# ============================================
# EXPORT CONFIGURATION
# ============================================
EXPORT_FORMAT_PDF_ENABLED=true
EXPORT_FORMAT_EXCEL_ENABLED=true
EXPORT_FORMAT_CSV_ENABLED=true
EXPORT_MAX_RECORDS=5000
